[Unit]
Description=ScalpLab Web UI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=scalp
WorkingDirectory=/opt/scalplab
ExecStart=/opt/scalplab/.venv/bin/scalp serve --host 0.0.0.0 --port 1120 --fd-limit 16384 --max-connections 64
Restart=on-failure
RestartSec=5
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
